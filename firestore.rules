rules_version = '2';

// All reads/writes go through Cloud Functions (Admin SDK), which bypasses
// these rules. Direct client access to Firestore is denied entirely so the
// health-record data can only ever be reached through the audited,
// role-checked Cloud Functions API in functions/index.js.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
