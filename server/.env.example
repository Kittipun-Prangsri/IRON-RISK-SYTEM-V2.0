# Copy to .env and fill in. NEVER commit .env (it holds secrets).

# ── Web ────────────────────────────────────────────────────────────────
# backend: API only (/api/*, /healthz)
PORT=5002
# frontend: web page + OAuth callbacks + /api — point Cloudflare Tunnel here
FRONTEND_PORT=5176
# The URL users open (behind nginx with HTTPS). Also used to build the
# Provider ID / LINE redirect URIs that must be registered with MOPH / LINE.
PUBLIC_BASE_URL=https://ironrisk.khostime.site
# Random string, at least 32 chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_HOURS=12
NODE_ENV=production
# Local development only — lets the mock SSO / dev quick-login log in without a password.
DEV_LOGIN=false

# ── Application database: Supabase (PostgreSQL) ────────────────────────
# Supabase Dashboard → your project → "Connect" → "Session pooler" → copy the URI
# and replace [YOUR-PASSWORD] with the database password. Use the SESSION pooler
# (port 5432), not the Transaction pooler (6543).
DATABASE_URL=
# Tables go in this schema (NOT "public", which Supabase exposes via its REST API).
DB_SCHEMA=iron_risk
# Optional but recommended: Supabase CA certificate file
# (Dashboard → Database → Settings → SSL Configuration → Download certificate).
DB_SSL_CA=

# ── HOSxP (read-only account) — for "เข้าสู่ระบบด้วย HOSxP Account" ──
HOSXP_ENABLED=false
HOSXP_DB_HOST=
HOSXP_DB_PORT=3306
HOSXP_DB_USER=
HOSXP_DB_PASSWORD=
HOSXP_DB_NAME=hos
# How opduser.passweb is stored at this site: md5 | plain  (confirm with the HOSxP admin)
HOSXP_PASSWORD_HASH=md5

# ── MOPH Health ID + Provider ID ───────────────────────────────────────
# prd = moph.id.th / provider.id.th,  uat = uat-moph.id.th / uat-provider.id.th
MOPH_ENV=prd
HEALTHID_CLIENT_ID=
HEALTHID_CLIENT_SECRET=
PROVIDERID_CLIENT_ID=
PROVIDERID_SECRET_KEY=
# Default: ${PUBLIC_BASE_URL}/auth/healthid/callback — must be registered with MOPH.
PROVIDERID_REDIRECT_URI=

# ── LINE Login (optional) ──────────────────────────────────────────────
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
# Default: ${PUBLIC_BASE_URL}/ — must be registered as Callback URL in LINE Developers.
LINE_REDIRECT_URI=
LIFF_ID=
