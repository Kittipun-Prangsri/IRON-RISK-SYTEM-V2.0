{
  "name": "iron-risk-server",
  "version": "1.0.0",
  "description": "Iron Zero Risk — on-premise server (Node.js + MySQL/MariaDB) for Khlong Hat Hospital",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:init": "node scripts/init-db.js",
    "import:sheets": "node scripts/import-sheets.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mysql2": "^3.11.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
